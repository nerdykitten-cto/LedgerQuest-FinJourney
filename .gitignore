# Ignore everything by default
/*

# Whitelist core files
!/.gitignore
!/PLANS/
!/APP/
!/Assets/
!/README.md
!/PREVIOUSLY.md
!/firebase.json
!/.firebaserc

# Test artifacts
**/test-results/
**/playwright-report/

# Specifically ignore GEMINI.md and CUSTOM_SKILLS folder
/GEMINI.md
/CUSTOM_SKILLS/

# General ignores for subdirectories (node, mobile, OS)
**/node_modules/
**/dist/
**/build/
**/.env
**/.DS_Store
**/Thumbs.db

# React Native / Flutter specific ignores
**/.expo/
**/ios/Pods/
**/ios/build/
**/android/app/build/
**/android/.gradle/
**/.dart_tool/
**/pubspec.lock
**/.packages
**/generated/

# Raw imported art dump — keep out of git (composed output is committed instead)
/Assets/imported_assets/

# Python
**/__pycache__/
*.pyc
